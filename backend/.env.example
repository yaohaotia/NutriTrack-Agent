# PowerShell examples; Spring Boot reads process environment, NOT this file automatically.
# Copy the needed values into your terminal or IDE run configuration.
DB_URL=jdbc:mysql://localhost:3306/nutritrack?useSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=replace-with-local-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to a private random string of at least 64 ASCII characters before deployment.
JWT_SECRET=
UPLOAD_PATH=D:/NutriTrack/images/
AGENT_API_KEY=
AGENT_BASE_URL=https://api.deepseek.com
# Choose a model supporting chat/completions tool_calls from your provider.
AGENT_MODEL=deepseek-flash
AGENT_DEMO_ENABLED=true
# Local persistent document/text/vector index; keep outside version control.
RAG_DATA_DIR=./.nutritrack-rag
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
